# Application (planned; not consumed during Phase 1)
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL + pgvector
POSTGRES_DB=flyrank
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://flyrank:replace-me@db:5432/flyrank

# Gemini Vision
GEMINI_API_KEY=replace-with-your-ai-studio-key
GEMINI_VISION_MODEL=replace-with-the-approved-free-tier-flash-model

# Local embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload and AI budget controls
IMAGE_STORAGE_ROOT=uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
AI_BUDGET_USD=0.00
