# Application
APP_NAME=FlyRank Image Relevance API
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Generate one local-only value (frk_ followed by at least 32 URL-safe random
# characters). Compose exposes this same value to Next.js at build time.
# Never commit the populated .env.
DEMO_API_KEY=

# PostgreSQL + pgvector
POSTGRES_DB=flyrank
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://flyrank:replace-me@db:5432/flyrank

# Deterministic local demo by default. Set gemini and a real key only when needed.
VISION_PROVIDER=corpus_fixture
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
VISION_TIMEOUT_SECONDS=30
VISION_LOW_CONFIDENCE_THRESHOLD=0.70
VISION_BUDGET_USD=1.00
# Conservative operator-supplied estimate used for budget reservation.
VISION_ESTIMATED_COST_PER_CALL_USD=0.001

# Durable image-processing worker
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_INITIAL_BACKOFF_SECONDS=5
PROCESSING_MAX_BACKOFF_SECONDS=300
# Must exceed VISION_TIMEOUT_SECONDS so a live provider call is not reclaimed.
PROCESSING_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1

# Local embeddings
EMBEDDING_PROVIDER=corpus_fixture
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EMBEDDING_DIMENSIONS=384
EMBEDDING_NORMALIZE=true
EVALUATION_DATASET_PATH=../data/evaluation.jsonl
CORPUS_MANIFEST_PATH=../data/corpus-manifest.json

# Upload controls
IMAGE_STORAGE_ROOT=uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
