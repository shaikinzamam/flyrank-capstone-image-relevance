# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL + pgvector
POSTGRES_DB=flyrank
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://flyrank:replace-me@db:5432/flyrank

# Gemini Vision
VISION_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-ai-studio-key
GEMINI_VISION_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=30
VISION_LOW_CONFIDENCE_THRESHOLD=0.70

# Local embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload controls (budget enforcement is deferred beyond Phase 4)
IMAGE_STORAGE_ROOT=uploads
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
AI_BUDGET_USD=0.00
